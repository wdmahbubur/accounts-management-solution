{
  "name": "accounts-management-solution",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@ams/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:application",
    "build": "npm run build --workspace=@ams/web",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:application": "node --test tests/application/*.test.mjs tests/application/*.test.ts",
    "test:reference": "cd docs && python -m unittest discover -s tests -v",
    "test:spec": "cd docs && python verification/check_spec.py",
    "test:database": "supabase test db",
    "test:race": "bash scripts/test-race-harness.sh",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.7",
    "typescript": "5.9.3"
  },
  "type": "module",
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
