{
  "name": "accounts-management-solution",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "24.x",
    "npm": "11.19.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/run-next.mjs dev apps/web",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:application",
    "build": "node scripts/run-next.mjs build apps/web",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:worker-credential": "node scripts/provision-local-worker-role.mjs",
    "demo:provision": "node scripts/provision-demo-account.mjs",
    "dev:secrets": "node scripts/provision-local-secrets.mjs",
    "env:check": "node scripts/check-environment.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:application": "node --conditions=react-server --test tests/application/*.test.mjs tests/application/*.test.ts",
    "test:database:cash-accounts": "node --test tests/database/cash-account-balance.test.mjs",
    "test:database:trade-register": "node --conditions=react-server --test tests/database/trade-register-status.test.mjs",
    "test:database:dashboard-liquidity": "node --test tests/database/dashboard-liquidity.test.mjs",
    "test:database:login-limiter": "node --conditions=react-server --test tests/database/login-rate-limit.test.mjs",
    "test:database:invoice-pdf": "node --conditions=react-server --test tests/database/invoice-pdf-download.test.mjs",
    "test:database:identity-verification": "node --conditions=react-server --test tests/database/identity-verification.test.mjs",
    "test:database:outbox-claim": "node --conditions=react-server --test tests/database/outbox-claim.test.mjs",
    "test:database:recovery": "node --conditions=react-server --test tests/database/recovery-files.test.mjs",
    "test:database:invitations": "node --conditions=react-server --test tests/database/invitation-security.test.mjs",
    "test:database:accounting": "node --conditions=react-server --test --test-concurrency=2 tests/database/golden-books.test.mjs tests/database/accounting-guards.test.mjs tests/database/approval-controls.test.mjs tests/database/period-year-controls.test.mjs tests/database/zero-nominal-year-close.test.mjs tests/database/cutover-classification.test.mjs tests/database/opening-overdue.test.mjs tests/database/concurrency-acceptance.test.mjs tests/database/bank-capacity-race.test.mjs tests/database/reversal-tenant-controls.test.mjs tests/database/reversal-dependencies.test.mjs tests/database/refund-safety.test.mjs tests/database/transaction-recovery.test.mjs",
    "test:database:advances": "node --conditions=react-server --test --test-concurrency=2 tests/database/advance-refund-settlement.test.mjs tests/database/opening-advance-settlement.test.mjs tests/database/refund-safety.test.mjs",
    "test:database:cash-flow-finalization": "node --conditions=react-server --test tests/database/cash-flow-finalization.test.mjs",
    "test:database:scanner": "node --conditions=react-server --test tests/database/attachment-scanner.test.mjs",
    "test:database:scan-checkpoints": "node --conditions=react-server --test tests/database/scan-provider-checkpoints.test.mjs",
    "test:database:bouncer": "node --conditions=react-server --test tests/database/bouncer-scanner.test.mjs",
    "test:database:subscription": "node --conditions=react-server --test tests/database/subscription-summary.test.mjs",
    "test:database:company-currency": "node --conditions=react-server --test tests/database/company-currency.test.mjs",
    "test:database:exports": "node --conditions=react-server --test tests/database/export-acceptance.test.mjs tests/database/issued-snapshot.test.mjs",
    "test:database:worker-recovery": "node --conditions=react-server --test tests/database/worker-recovery.test.mjs",
    "test:database:http-security": "node --conditions=react-server --test tests/database/http-security.test.mjs",
    "recovery:database": "node scripts/recovery-database.mjs",
    "test:reference": "cd docs && python -m unittest discover -s tests -v",
    "test:spec": "cd docs && python verification/check_spec.py"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "typescript": "5.9.3"
  },
  "type": "module",
  "overrides": {
    "source-map-js": "1.2.2",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
