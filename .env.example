# Configuration names only. Never commit real secret/service-role/encryption keys.
# Only NEXT_PUBLIC_ variables below may be exposed to the browser.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Migration owner credential; used only by `npm run db:migrate`.
DATABASE_URL=
# Restricted application credential; never use the migration-owner URL at runtime.
DATABASE_RUNTIME_URL=
# Restricted worker-only credential. Provision locally with `npm run db:worker-credential`.
DATABASE_WORKER_URL=
# Generate with `npx auth secret`; server-only.
AUTH_SECRET=
# Optional SMTP settings. In local development, mail previews are written to
# the ignored .local-mail-preview directory. Production requires both values.
SMTP_URL=
SMTP_FROM=
# Server-to-server bearer secret for the internal outbox worker endpoint. Generate at least 32 random bytes.
OUTBOX_WORKER_SECRET=
# Server-to-server bearer secret for the internal export worker endpoint. Generate at least 32 random bytes.
EXPORT_WORKER_SECRET=
# Server-to-server bearer secret for the internal attachment scanner worker. Generate at least 32 random bytes.
ATTACHMENT_SCAN_WORKER_SECRET=
# Private-network ClamAV daemon reached only by the server-side worker. Never expose clamd publicly.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Private S3-compatible evidence storage. Production requires a bucket and
# server-only workload credentials; local development defaults to private files.
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=
AWS_REGION=us-east-1
# Server-only: 32 cryptographically random bytes encoded as 64 hexadecimal characters.
# Required for invitation issuance; never use a NEXT_PUBLIC_ variable or commit a real key.
INVITATION_DELIVERY_KEY=
